# Sao chép file này thành .env rồi điền giá trị lấy ở Supabase: Project Settings > API Keys
# (Data API cho URL). Khóa anon / publishable được phép nằm trong code chạy trên trình duyệt;
# TUYỆT ĐỐI không dùng khóa service_role / secret ở đây.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
